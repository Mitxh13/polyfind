# App
NODE_ENV=development
APP_URL=http://localhost:3000

# MySQL (authoritative relational data)
DATABASE_URL=mysql://polyfind:change-me@localhost:3306/polyfind

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Vector database adapter configuration (final backend selected in S1)
VECTOR_STORE_PROVIDER=
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# Embeddings provider (choose and document before implementation)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Auth / application secrets
AUTH_SECRET=replace-with-local-random-secret
